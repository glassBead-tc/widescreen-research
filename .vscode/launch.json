{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Coordinator",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/coordinator",
      "env": {
        "LOG_LEVEL": "debug",
        "PORT": "8080"
      }
    },
    {
      "name": "Launch Drone",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/drone",
      "env": {
        "LOG_LEVEL": "debug",
        "DRONE_TYPE": "research"
      }
    },
    {
      "name": "Test Current Package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    }
  ]
}