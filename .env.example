# Local development only. Do NOT commit real secrets.
# Copy to .env and fill in values, or export in your shell.

# Common
LOG_LEVEL=info
PORT=8080

# GCP
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

# Coordinator
# Optional base URL for drones to call back in local dev
COORDINATOR_BASE_URL=http://localhost:8080

# Drone
DRONE_TYPE=research
DRONE_ID=test-drone-001
PUBSUB_TOPIC=drone-tasks

# External APIs
# Inject from Secret Manager in Cloud Run. For local dev, set here if needed.
EXA_API_KEY=replace-me-for-local-only
